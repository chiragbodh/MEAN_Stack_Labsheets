          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Chirag Bodh\",\n  \"course\": \"MCA\",\n  \"city\": \"Saharanpur\",\n  \"marks\": 120\n}",
          "options": {
